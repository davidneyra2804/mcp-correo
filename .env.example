# Copia este fichero a .env y sustituye los valores ficticios. No subas .env a git.
# Genera cada secreto de forma independiente con: openssl rand -base64 48
MCP_BEARER_TOKEN=token-ficticio-reemplazar-con-openssl-rand-base64-48
MCP_DASHBOARD_KEY=clave-ficticia-del-panel-0123456789abcdef
MCP_DASHBOARD_TOKEN=token-ficticio-del-panel-0123456789abcdef

# Las cuentas y sus credenciales se crean en el panel. La clave del panel
# cifra las contraseñas: guarda una copia separada de la base de datos.
# El compose guarda la base en el volumen data; no lo elimines.
# MCP_DASHBOARD_DB=/var/lib/mcp-correo/cuentas.db
# MCP_DASHBOARD_BIND_HOST=127.0.0.1
# MCP_DASHBOARD_BIND_PORT=8766

# Interruptores globales de escritura. Los permisos de dominio y cuenta se
# configuran en el panel. Valores admitidos: true, false, 1 y 0.
MCP_ENABLE_SEND=false
MCP_ENABLE_MARK=false
MCP_ENABLE_DELETE=false
MCP_ENABLE_DRAFTS=false

MCP_PUBLIC_HOST=mcp.example.com
# MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*,127.0.0.1:*
# MCP_ALLOWED_ORIGINS=https://mcp.example.com,http://127.0.0.1:*
# El compose fija estas opciones dentro del contenedor.
# MCP_BIND_HOST=127.0.0.1
# MCP_BIND_PORT=8765
# MCP_ALLOW_NONLOCAL_BIND=1
# MCP_AUDIT_LOG=/var/log/mcp-correo/audit.jsonl

# Límites y política SMTP.
# MCP_MAX_RESULTS=100
# MCP_MAX_CHARS=20000
# MCP_MAX_ATTACHMENT_BYTES=5000000
# MCP_MAX_MESSAGE_BYTES=15000000
# MCP_IMAP_TIMEOUT=20
# MCP_SENT_SCAN_LIMIT=300
# MCP_CONFIRM_TTL_SECONDS=600
# MCP_MAX_RECIPIENTS=10
# MCP_MAX_SENDS_PER_DAY=30
# MCP_MAX_DELETE_PER_CALL=20
# MCP_MAX_MARK_PER_CALL=50
# MCP_SMTP_TIMEOUT=30
# MCP_SMTP_SECURITY=ssl
# MCP_ALLOWED_RECIPIENT_DOMAINS=corp.example.com,partner.example.com
# MCP_ALLOWED_ATTACHMENT_TYPES=text/plain,application/pdf,image/png

# Compose, publicación y rotación de auditoría.
# MCP_IMAGE=mcp-correo:local
# MCP_PULL_POLICY=build
# MCP_PUBLISH_BIND=127.0.0.1
# MCP_PUBLISH_PORT=8765
# MCP_DASHBOARD_PUBLISH_BIND=127.0.0.1
# MCP_DASHBOARD_PUBLISH_PORT=8766
# MCP_STACK_ENV_FILE=stack.env
# MCP_AUDIT_MAX_BYTES=10485760
# MCP_AUDIT_KEEP=12
# MCP_AUDIT_ROTATE_SECONDS=3600

# Opcionales: Cloudflare Tunnel o Caddy.
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_PROTOCOL=quic
# CLOUDFLARED_VERSION=latest
# CADDY_HTTP_BIND=0.0.0.0
# CADDY_HTTPS_BIND=0.0.0.0
