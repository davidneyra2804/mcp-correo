# Datos FICTICIOS. No pongas aquí tokens ni contraseñas reales.
# Copia este archivo fuera del repositorio, por ejemplo a /etc/vyr-mail-mcp/env,
# y deja ese archivo con permisos 0600 (chmod 0600) y dueño root.
# Token recomendado: openssl rand -base64 48

MCP_BEARER_TOKEN=token-ficticio-reemplazar-con-openssl-rand-base64-48
MAIL_VYRTS_PASSWORD=contraseña-ficticia-vyrts
MAIL_CARBONIO_PASSWORD=contraseña-ficticia-carbonio
MCP_CONFIG=./accounts.example.toml
MCP_AUDIT_LOG=./audit.jsonl

# El envío, el marcado y el borrado no se activan aquí.
# Van en accounts.toml (enable_* y allow_*), apagados por defecto.

# Opcional. Por defecto el proceso escucha solo en loopback.
# MCP_BIND_HOST=127.0.0.1
# MCP_BIND_PORT=8765
